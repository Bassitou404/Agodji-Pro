def save_result(outdir: str, filename: str, data):
    path = os.path.join(outdir, filename)
    with open(path, "w") as f:
        if isinstance(data, (dict, list)):
            json.dump(data, f, indent=2, default=str)
        else:
            f.write(str(data))
    log(S.OK, f"Sauvegardé", path)

# ─── Port Scanner ─────────────────────────────────────────────────────────────
def scan_port(host: str, port: int, timeout: float = 1.0) -> dict:
    result = {"port": port, "state": "closed", "service": CLOUD_PORTS.get(port, "unknown"), "banner": ""}
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(timeout)
        conn = sock.connect_ex((host, port))
        if conn == 0:
            result["state"] = "open"
            try:
                if port in [443, 8443, 636, 9200]:
                    ctx = ssl.create_default_context()
                    ctx.check_hostname = False
                    ctx.verify_mode = ssl.CERT_NONE
                    with ctx.wrap_socket(sock, server_hostname=host) as ssock:
                        ssock.settimeout(0.5)
                        try:
                            banner = ssock.recv(256).decode(errors="replace").strip()
                            result["banner"] = banner[:80]
                        except Exception:
                            pass
                else:
                    sock.settimeout(0.5)
                    try:
                        banner = sock.recv(256).decode(errors="replace").strip()
                        result["banner"] = banner[:80]
                    except Exception:
                        pass
            except Exception:
                pass
        sock.close()
    except Exception:
        pass
    return result

def cloud_port_scan(target: str, ports: Optional[list] = None, threads: int = 150, timeout: float = 1.0) -> list:
    header("Port Scan — Énumération Cloud")
    if ports is None:
        ports = list(CLOUD_PORTS.keys())
    log(S.INFO, f"Cible     : {C.TEAL}{target}{C.RESET}")
    log(S.INFO, f"Ports     : {C.SILVER}{len(ports)} ports cloud spécifiques{C.RESET}")
    log(S.INFO, f"Threads   : {C.SILVER}{threads}{C.RESET}")
    log(S.INFO, f"Timeout   : {C.SILVER}{timeout}s{C.RESET}")
    print()
    open_ports = []
    start = time.time()
    with concurrent.futures.ThreadPoolExecutor(max_workers=threads) as ex:
        futures = {ex.submit(scan_port, target, p, timeout): p for p in ports}
        done = 0
        for fut in concurrent.futures.as_completed(futures):
            done += 1
            res = fut.result()
            if res["state"] == "open":
                open_ports.append(res)
                svc = f"{C.GOLD}{res['service']}{C.RESET}"
                banner = f"{C.GRAY}  ↳ {res['banner']}{C.RESET}" if res["banner"] else ""
                print(f"  {S.FIND}  {C.GREEN}OPEN{C.RESET}  {C.WHITE}{str(res['port']).ljust(6)}{C.RESET}  {svc}{banner}")
            pct = int(done / len(ports) * 50)
            bar = f"{'█' * pct}{'░' * (50 - pct)}"
            sys.stdout.write(f"\r  {C.GRAY}[{bar}] {done}/{len(ports)}{C.RESET}")
            sys.stdout.flush()
    elapsed = time.time() - start
    print(f"\n\n{S.SEP}")
    log(S.OK, f"{C.GREEN}{len(open_ports)} port(s) ouverts{C.RESET} trouvés en {elapsed:.1f}s")
    return open_ports

# ─── Metadata IMDS ────────────────────────────────────────────────────────────
def check_metadata_endpoints(timeout: float = 2.0) -> dict:
    header("Metadata IMDS — Détection Fournisseur Cloud")
    results = {}
    for name, url in METADATA_ENDPOINTS.items():
        try:
            req = urllib.request.Request(url)
            if "Azure" in name:
                req.add_header("Metadata", "true")
            if "GCP" in name:
                req.add_header("Metadata-Flavor", "Google")
            if "IMDSv2" in name:
                req.add_header("X-aws-ec2-metadata-token-ttl-seconds", "21600")
                req.method = "PUT"
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                body = resp.read(512).decode(errors="replace")
                results[name] = {"status": resp.status, "body": body[:200]}
                log(S.FIND, f"{C.GOLD}{name}{C.RESET}", f"HTTP {resp.status} — {body[:60]}...")
        except urllib.error.HTTPError as e:
            results[name] = {"status": e.code, "error": str(e)}
            log(S.WARN, f"{C.SILVER}{name}{C.RESET}", f"HTTP {e.code}")
        except Exception as e:
            results[name] = {"error": str(e)}
            log(S.BULLET, f"{C.GRAY}{name}{C.RESET}", "Non accessible")
    return results

# ─── S3 Bucket Enumeration ────────────────────────────────────────────────────
def enumerate_s3_buckets(name: str, region: str = "us-east-1") -> list:
    header("S3 / Blob Storage — Enumération Buckets Publics")
    log(S.INFO, f"Nom de base : {C.TEAL}{name}{C.RESET}")
    found = []
    permutations = [p.format(name=name) for p in BUCKET_PERMUTATIONS]
    log(S.INFO, f"Permutations: {C.SILVER}{len(permutations)}{C.RESET}")
    print()

    def check_bucket(bucket_name):
        endpoints = [
            f"https://{bucket_name}.s3.amazonaws.com",
            f"https://{bucket_name}.s3.{region}.amazonaws.com",
            f"https://storage.googleapis.com/{bucket_name}",
            f"https://{bucket_name}.blob.core.windows.net",
        ]
        for url in endpoints:
            try:
                req = urllib.request.Request(url, method="HEAD")
                with urllib.request.urlopen(req, timeout=3) as resp:
                    return {"bucket": bucket_name, "url": url, "status": resp.status,
                            "headers": dict(resp.headers)}
            except urllib.error.HTTPError as e:
                if e.code == 403:
                    return {"bucket": bucket_name, "url": url, "status": 403,
                            "note": "Exists but private"}
                elif e.code == 200:
                    return {"bucket": bucket_name, "url": url, "status": 200, "note": "PUBLIC"}
            except Exception:
                pass
        return None

    with concurrent.futures.ThreadPoolExecutor(max_workers=50) as ex:
        futures = {ex.submit(check_bucket, b): b for b in permutations}
        for fut in concurrent.futures.as_completed(futures):
            res = fut.result()
            if res:
                found.append(res)
                if res.get("status") == 403:
                    log(S.WARN, f"{C.GOLD}{res['bucket']}{C.RESET}", f"Existe (privé) — {res['url']}")
                elif res.get("status") == 200:
                    log(S.FIND, f"{C.RED}PUBLIC{C.RESET} {C.WHITE}{res['bucket']}{C.RESET}", res["url"])
                else:
                    log(S.INFO, f"{C.SILVER}{res['bucket']}{C.RESET}", res["url"])

    log(S.OK, f"{C.GREEN}{len(found)} bucket(s) détectés{C.RESET}")
    return found

# ─── Subdomain Enumeration ────────────────────────────────────────────────────
def enumerate_subdomains(domain: str) -> list:
    header("Sous-domaines Cloud — Énumération DNS")
    log(S.INFO, f"Domaine : {C.TEAL}{domain}{C.RESET}")
    log(S.INFO, f"Wordlist: {C.SILVER}{len(CLOUD_SUBDOMAINS)} sous-domaines cloud{C.RESET}")
    print()
    found = []

    def resolve(sub):
        fqdn = f"{sub}.{domain}"
        try:
            addrs = socket.getaddrinfo(fqdn, None)
            ips = list({a[4][0] for a in addrs})
            return {"subdomain": fqdn, "ips": ips}
        except Exception:
            return None

    with concurrent.futures.ThreadPoolExecutor(max_workers=80) as ex:
        futures = {ex.submit(resolve, s): s for s in CLOUD_SUBDOMAINS}
        for fut in concurrent.futures.as_completed(futures):
            res = fut.result()
            if res:
                found.append(res)
                ips_str = ", ".join(res["ips"])
                log(S.FIND, f"{C.GOLD}{res['subdomain']}{C.RESET}", f"{C.TEAL}{ips_str}{C.RESET}")

    log(S.OK, f"{C.GREEN}{len(found)} sous-domaine(s) résolus{C.RESET}")
    return found

# ─── SSL/TLS Certificate Inspection ──────────────────────────────────────────
def inspect_ssl(host: str, port: int = 443) -> dict:
    header("Inspection Certificat SSL/TLS")
    result = {}
    try:
        ctx = ssl.create_default_context()
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
        with socket.create_connection((host, port), timeout=5) as sock:
            with ctx.wrap_socket(sock, server_hostname=host) as ssock:
                cert = ssock.getpeercert()
                cipher = ssock.cipher()
                proto = ssock.version()
                result = {
                    "subject": dict(x[0] for x in cert.get("subject", [])),
                    "issuer": dict(x[0] for x in cert.get("issuer", [])),
                    "san": [v for t, v in cert.get("subjectAltName", [])],
                    "not_before": cert.get("notBefore"),
                    "not_after": cert.get("notAfter"),
                    "protocol": proto,
                    "cipher": cipher[0] if cipher else "unknown",
                }
                cn = result["subject"].get("commonName", "N/A")
                log(S.FIND, f"CN         : {C.GOLD}{cn}{C.RESET}")
                log(S.INFO, f"Protocole  : {C.TEAL}{proto}{C.RESET}")
                log(S.INFO, f"Cipher     : {C.SILVER}{result['cipher']}{C.RESET}")
                log(S.INFO, f"Expiration : {C.SILVER}{result['not_after']}{C.RESET}")
                if result["san"]:
                    log(S.INFO, f"SANs ({len(result['san'])}) :", "")
                    for san in result["san"][:10]:
                        print(f"    {S.BULLET} {C.TEAL}{san}{C.RESET}")
    except Exception as e:
        log(S.ERR, f"Erreur SSL", str(e))
    return result

# ─── Cloud Provider Detection ─────────────────────────────────────────────────
def detect_cloud_provider(ip: str) -> str:
    header("Détection Fournisseur Cloud")
    log(S.INFO, f"IP : {C.TEAL}{ip}{C.RESET}")

    # Plages IP connues (simplifiées)
    aws_prefixes = ["3.", "13.", "15.", "18.", "34.", "35.", "52.", "54.", "99.", "100."]
    azure_prefixes = ["20.", "40.", "51.", "52.", "104.", "137.", "138.", "157."]
    gcp_prefixes = ["34.", "35.", "104.", "130.", "142.", "146.", "209."]

    first_octet_prefix = ".".join(ip.split(".")[:2]) + "."
    first = ip.split(".")[0] + "."

    provider = "Unknown"
    if any(ip.startswith(p) for p in aws_prefixes):
        provider = "AWS (Amazon Web Services)"
    elif any(ip.startswith(p) for p in azure_prefixes):
        provider = "Azure (Microsoft)"
    elif any(ip.startswith(p) for p in gcp_prefixes):
        provider = "GCP (Google Cloud Platform)"

    # Reverse DNS
    try:
        rdns = socket.gethostbyaddr(ip)[0]
        log(S.FIND, f"rDNS       : {C.GOLD}{rdns}{C.RESET}")
        if "amazonaws" in rdns or "aws" in rdns:
            provider = "AWS (Amazon Web Services)"
        elif "azure" in rdns or "microsoft" in rdns:
            provider = "Azure (Microsoft)"
        elif "google" in rdns or "gcp" in rdns:
            provider = "GCP (Google Cloud Platform)"
        elif "digitalocean" in rdns:
            provider = "DigitalOcean"
        elif "linode" in rdns:
            provider = "Linode (Akamai)"
        elif "vultr" in rdns:
            provider = "Vultr"
        elif "hetzner" in rdns:
            provider = "Hetzner"
        elif "ovh" in rdns:
            provider = "OVH"
    except Exception:
        log(S.WARN, "Pas de reverse DNS")

    color = C.ORANGE if provider != "Unknown" else C.GRAY
    log(S.OK, f"Fournisseur: {color}{provider}{C.RESET}")
    return provider

# ─── HTTP Headers Analysis ────────────────────────────────────────────────────
def analyze_http_headers(host: str, port: int = 443, use_ssl: bool = True) -> dict:
    header("Analyse Headers HTTP — Fingerprinting")
    results = {}
    paths = ["/", "/api", "/admin", "/health", "/status", "/v1", "/.well-known/security.txt"]
    proto = "https" if use_ssl else "http"
    for path in paths:
        url = f"{proto}://{host}:{port}{path}"
        try:
            req = urllib.request.Request(url)
            req.add_header("User-Agent", "Agodjie/1.0 Cloud-Scanner")
            ctx = ssl.create_default_context()
            ctx.check_hostname = False
            ctx.verify_mode = ssl.CERT_NONE
            with urllib.request.urlopen(req, context=ctx, timeout=3) as resp:
                headers = dict(resp.headers)
                results[path] = {"status": resp.status, "headers": headers}
                log(S.FIND, f"{C.GOLD}HTTP {resp.status}{C.RESET}  {C.TEAL}{path}{C.RESET}")
                interesting = ["Server", "X-Powered-By", "X-Cloud-Trace-Id",
                               "X-Amzn-RequestId", "X-Azure-Ref", "Via",
                               "X-Frame-Options", "Content-Security-Policy",
                               "Strict-Transport-Security", "X-Content-Type-Options"]
                for h in interesting:
                    if h in headers:
                        log(S.INFO, f"  {h}: {C.SILVER}{headers[h][:80]}{C.RESET}")
        except Exception as e:
            log(S.BULLET, f"{C.GRAY}{path}{C.RESET}", str(e)[:60])
    return results

# ─── DNS Records ──────────────────────────────────────────────────────────────
def enum_dns_records(domain: str) -> dict:
    header("Énumération DNS — Records Cloud")
    records = {}
    record_types = ["A", "AAAA", "MX", "TXT", "NS", "CNAME", "SOA", "PTR"]
    for rtype in record_types:
        try:
            cmd = ["dig", "+short", rtype, domain]
            result = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
            if result.stdout.strip():
                lines = [l for l in result.stdout.strip().split("\n") if l]
                records[rtype] = lines
                log(S.FIND, f"{C.GOLD}{rtype.ljust(6)}{C.RESET}", "")
                for line in lines:
                    print(f"    {S.ARROW} {C.TEAL}{line}{C.RESET}")
                if rtype == "TXT":
                    for txt in lines:
                        if "v=spf1" in txt:
                            log(S.INFO, "SPF record détecté", txt[:80])
                        if "google-site-verification" in txt:
                            log(S.WARN, "Google Workspace détecté")
                        if "MS=" in txt:
                            log(S.WARN, "Microsoft 365 / Azure AD détecté")
                        if "amazonses" in txt:
                            log(S.WARN, "Amazon SES détecté")
        except Exception as e:
            log(S.BULLET, f"{C.GRAY}{rtype}{C.RESET}", str(e)[:40])
    return records

