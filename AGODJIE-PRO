        f.write(f"# AGODJIÉ — Rapport d'Énumération Cloud\n\n")
        f.write(f"- **Cible**    : `{target}`\n")
        f.write(f"- **Date**     : {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\n")
        f.write(f"- **Auteur**   : @T3RRIFI3R\n\n")
        f.write("---\n\n")
        for section, data in results.items():
            f.write(f"## {section}\n\n")
            f.write(f"```json\n{json.dumps(data, indent=2, default=str)}\n```\n\n")
    log(S.OK, f"Markdown: {C.TEAL}{md_path}{C.RESET}")

    # Résumé terminal
    print(f"\n{S.SEP2}")
    print(f"  {C.GOLD}{C.BOLD}RÉSUMÉ EXÉCUTIF{C.RESET}")
    print(f"{S.SEP2}\n")
    if "ports" in results:
        open_p = [p for p in results["ports"] if p.get("state") == "open"]
        log(S.OK, f"{C.GREEN}{len(open_p)} port(s) ouverts{C.RESET}")
        for p in open_p:
            print(f"    {S.ARROW} {C.WHITE}{p['port']}/TCP{C.RESET}  {C.GOLD}{p['service']}{C.RESET}")
    if "subdomains" in results and results["subdomains"]:
        log(S.OK, f"{C.GREEN}{len(results['subdomains'])} sous-domaine(s) découverts{C.RESET}")
    if "buckets" in results and results["buckets"]:
        public = [b for b in results["buckets"] if b.get("status") == 200]
        log(S.WARN if public else S.INFO,
            f"{C.RED if public else C.SILVER}{len(public)} bucket(s) public(s){C.RESET} "
            f"sur {len(results['buckets'])} détectés")
    print()

# ─── CLI ─────────────────────────────────────────────────────────────────────
def build_parser():
    p = argparse.ArgumentParser(
        prog="agodjie",
        description="AGODJIÉ — Cloud Enumeration Scanner by @T3RRIFI3R",
        formatter_class=argparse.RawTextHelpFormatter,
    )
    p.add_argument("target", help="IP, CIDR, ou domaine cible")
    p.add_argument("-m", "--modules", nargs="+",
                   choices=["ports", "metadata", "ssl", "headers", "dns", "subdomains", "buckets", "all"],
                   default=["all"], help="Modules à exécuter")
    p.add_argument("-o", "--output", default="./agodjie_output", help="Répertoire de sortie")
    p.add_argument("-t", "--threads", type=int, default=150, help="Nombre de threads (défaut: 150)")
    p.add_argument("--timeout", type=float, default=1.0, help="Timeout socket (défaut: 1.0s)")
    p.add_argument("--region", default="us-east-1", help="Région AWS pour les buckets")
    p.add_argument("--bucket-name", help="Nom de base pour l'énumération des buckets")
    p.add_argument("--port", type=int, default=443, help="Port pour SSL/HTTP (défaut: 443)")
    p.add_argument("-q", "--quiet", action="store_true", help="Mode silencieux")
    p.add_argument("--no-banner", action="store_true", help="Masquer le banner")
    return p

# ─── Main ─────────────────────────────────────────────────────────────────────
def main():
    parser = build_parser()
    args = parser.parse_args()

    if not args.no_banner:
        print(BANNER)

    # Créer le répertoire de sortie
    os.makedirs(args.output, exist_ok=True)

    target = args.target
    modules = args.modules
    run_all = "all" in modules

    results = {"target": target, "timestamp": datetime.now().isoformat()}

    # Résolution IP si domaine
    target_ip = target
    target_domain = None
    try:
        ipaddress.ip_address(target)
    except ValueError:
        target_domain = target
        try:
            target_ip = socket.gethostbyname(target)
            log(S.INFO, f"Résolution DNS : {C.TEAL}{target}{C.RESET} → {C.GOLD}{target_ip}{C.RESET}")
        except Exception as e:
            log(S.WARN, f"Impossible de résoudre {target}", str(e))

    # ── Détection provider ──
    if run_all or "ports" in modules:
        results["provider"] = detect_cloud_provider(target_ip)

    # ── Port scan ──
    if run_all or "ports" in modules:
        results["ports"] = cloud_port_scan(target_ip, threads=args.threads, timeout=args.timeout)

    # ── Metadata IMDS ──
    if run_all or "metadata" in modules:
        results["metadata"] = check_metadata_endpoints(timeout=args.timeout * 2)

    # ── SSL ──
    if run_all or "ssl" in modules:
        results["ssl"] = inspect_ssl(target, port=args.port)

    # ── HTTP Headers ──
    if run_all or "headers" in modules:
        results["headers"] = analyze_http_headers(target, port=args.port)

    # ── DNS ──
    if target_domain and (run_all or "dns" in modules):
        results["dns"] = enum_dns_records(target_domain)

    # ── Subdomains ──
    if target_domain and (run_all or "subdomains" in modules):
        results["subdomains"] = enumerate_subdomains(target_domain)

    # ── Buckets ──
    if run_all or "buckets" in modules:
        bucket_name = args.bucket_name or (target_domain.split(".")[0] if target_domain else target_ip.replace(".", "-"))
        results["buckets"] = enumerate_s3_buckets(bucket_name, region=args.region)

    # ── Rapport ──
    generate_report(results, args.output, target)

    print(f"\n  {C.GOLD}Agodjié terminé. Guerrières du Dahomey, mission accomplie.{C.RESET}\n")

if __name__ == "__main__":
    main()

